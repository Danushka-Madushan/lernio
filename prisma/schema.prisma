datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Grade {
  GRADE_6
  GRADE_7
  GRADE_8
  GRADE_9
  GRADE_10
  GRADE_11
}

enum VideoVisibility {
  PUBLIC
  GRADE
}

enum AccessMode {
  GRADE
  CUSTOM
}

model User {
  id             String     @id @default(uuid())
  username       String     @unique
  hashedPassword String
  role           Role       @default(STUDENT)
  grade          Grade?
  allowedGrades  Grade[]    @default([GRADE_6, GRADE_7, GRADE_8, GRADE_9, GRADE_10, GRADE_11])
  gradeAliases   Json?      @default("{}")
  activeFrom     DateTime?
  activeTo       DateTime?
  accessMode     AccessMode @default(GRADE)
  teacherId      String?
  teacher        User?      @relation("TeacherStudents", fields: [teacherId], references: [id], onDelete: SetNull)
  students       User[]     @relation("TeacherStudents")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  comments       Comment[]
  likes          Like[]
  views          View[]
  customVideos   CustomVideoAccess[]
  videos         Video[]    @relation("TeacherVideos")
  meetings       ZoomLink[] @relation("TeacherMeetings")
  zoomAccounts   ZoomAccount[] @relation("TeacherZoomAccounts")
  examGroups     ExamGroup[] @relation("TeacherExamGroups")
  exams          Exam[]      @relation("TeacherExams")
  examMarks      ExamMark[]  @relation("StudentExamMarks")
}

model Video {
  id                       String          @id @default(uuid())
  title                    String
  description              String?
  cloudflareR2Key          String
  cloudflareR2ThumbnailKey String?
  grade                    Grade?
  visibility               VideoVisibility @default(PUBLIC)
  viewsCount               Int             @default(0)
  teacherId                String?
  teacher                  User?           @relation("TeacherVideos", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  comments     Comment[]
  likes        Like[]
  views        View[]
  customVideos CustomVideoAccess[]
}

model ZoomAccount {
  id           String     @id @default(uuid())
  name         String
  email        String
  accountId    String
  clientId     String
  clientSecret String
  picUrl       String?
  userId       String?
  user         User?      @relation("TeacherZoomAccounts", fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  zoomLinks    ZoomLink[]
}

model ZoomLink {
  id          String   @id @default(uuid())
  title       String
  scheduledAt DateTime
  grade       Grade?
  link        String   // Student join URL
  
  teacherId   String?
  teacher     User?    @relation("TeacherMeetings", fields: [teacherId], references: [id], onDelete: Cascade)

  zoomAccountId String?
  zoomAccount   ZoomAccount? @relation(fields: [zoomAccountId], references: [id], onDelete: SetNull)
  meetingId     String?
  startUrl      String?
  duration      Int?
  isRecurring   Boolean      @default(false)
  hostVideo     Boolean      @default(false)
  participantVideo Boolean   @default(false)
  waitingRoom   Boolean      @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model CustomVideoAccess {
  id      String @id @default(uuid())
  userId  String
  videoId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model View {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model ExamGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  teacherId   String
  teacher     User     @relation("TeacherExamGroups", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exams       Exam[]
}

model Exam {
  id             String      @id @default(uuid())
  title          String
  description    String?
  subject        String
  grade          Grade
  examGroupId    String?
  examGroup      ExamGroup?  @relation(fields: [examGroupId], references: [id], onDelete: SetNull)
  teacherId      String
  teacher        User        @relation("TeacherExams", fields: [teacherId], references: [id], onDelete: Cascade)
  thresholdMarks Float       @default(50)
  maxMarks       Float       @default(100)
  examDate       DateTime
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  marks          ExamMark[]
}

model ExamMark {
  id        String   @id @default(uuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentExamMarks", fields: [studentId], references: [id], onDelete: Cascade)
  marks     Float?
  isAbsent  Boolean  @default(false)
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId])
}
